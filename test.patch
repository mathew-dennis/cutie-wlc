+void CwlCompositor::triggerRender(QWaylandOutput *output)
+{
+	QWindow *window = output ? output->window() : nullptr;
+	if (!window) {
+		triggerRender();
+		return;
+	}
+	if (window == m_glwindow && m_glwindow->displayOff())
+		return;
+	window->requestUpdate();
+}
